rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'schoolName', 'defaultCurrency', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'schoolName', 'defaultCurrency', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 140
        && data.defaultCurrency in ['USD', 'KHR']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassGroup(data) {
      return data.keys().hasAll(['ownerId', 'name', 'schedule', 'feeAmount', 'currency', 'billingCycle', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'schedule', 'feeAmount', 'currency', 'billingCycle', 'isActive', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.schedule is string && data.schedule.size() >= 1 && data.schedule.size() <= 120
        && (data.feeAmount is int || data.feeAmount is float) && data.feeAmount >= 0 && data.feeAmount <= 100000000
        && data.currency in ['USD', 'KHR']
        && data.billingCycle in ['monthly', 'session']
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['ownerId', 'studentCode', 'fullName', 'gender', 'parentPhone', 'classId', 'className', 'monthlyFee', 'currency', 'dueDay', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'studentCode', 'fullName', 'gender', 'parentPhone', 'classId', 'className', 'monthlyFee', 'currency', 'dueDay', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.studentCode is string && data.studentCode.size() >= 1 && data.studentCode.size() <= 32 && data.studentCode.matches('^[a-zA-Z0-9_\\-]+$')
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.gender in ['male', 'female']
        && data.parentPhone is string && data.parentPhone.size() <= 40
        && data.classId is string && isValidId(data.classId)
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 120
        && (data.monthlyFee is int || data.monthlyFee is float) && data.monthlyFee >= 0 && data.monthlyFee <= 100000000
        && data.currency in ['USD', 'KHR']
        && data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31
        && data.status in ['active', 'paused']
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['ownerId', 'receiptNo', 'studentId', 'studentName', 'classId', 'className', 'billingMonth', 'amountPaid', 'expectedAmount', 'currency', 'method', 'paymentStatus', 'paidDate', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'receiptNo', 'studentId', 'studentName', 'classId', 'className', 'billingMonth', 'amountPaid', 'expectedAmount', 'currency', 'method', 'paymentStatus', 'paidDate', 'note', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.receiptNo is string && data.receiptNo.size() >= 1 && data.receiptNo.size() <= 40 && data.receiptNo.matches('^[a-zA-Z0-9_\\-]+$')
        && data.studentId is string && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && data.classId is string && isValidId(data.classId)
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 120
        && data.billingMonth is string && data.billingMonth.size() == 7 && data.billingMonth.matches('^[0-9]{4}-[0-9]{2}$')
        && (data.amountPaid is int || data.amountPaid is float) && data.amountPaid > 0 && data.amountPaid <= 100000000
        && (data.expectedAmount is int || data.expectedAmount is float) && data.expectedAmount >= 0 && data.expectedAmount <= 100000000
        && data.currency in ['USD', 'KHR']
        && data.method in ['cash', 'khqr', 'transfer']
        && data.paymentStatus in ['paid', 'partial']
        && data.paidDate is string && data.paidDate.size() == 10 && data.paidDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.note is string && data.note.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // PII Isolation: User profile strictly accessible only by owner
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'schoolName', 'defaultCurrency', 'updatedAt']);
      allow delete: if false;
    }

    match /classes/{classId} {
      allow get: if isValidId(classId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(classId)
        && isSignedIn()
        && isValidClassGroup(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(classId)
        && isOwner(existing().ownerId)
        && isValidClassGroup(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'schedule', 'feeAmount', 'currency', 'billingCycle', 'isActive', 'updatedAt']);
      allow delete: if isValidId(classId) && isOwner(existing().ownerId);
    }

    match /students/{studentId} {
      allow get: if isValidId(studentId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(studentId)
        && isSignedIn()
        && isValidStudent(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/classes/$(incoming().classId))
        && get(/databases/$(database)/documents/classes/$(incoming().classId)).data.ownerId == request.auth.uid;
      allow update: if isValidId(studentId)
        && isOwner(existing().ownerId)
        && isValidStudent(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().studentCode == existing().studentCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/classes/$(incoming().classId))
        && get(/databases/$(database)/documents/classes/$(incoming().classId)).data.ownerId == request.auth.uid
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'gender', 'parentPhone', 'classId', 'className', 'monthlyFee', 'currency', 'dueDay', 'status', 'notes', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        );
      allow delete: if isValidId(studentId) && isOwner(existing().ownerId);
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(paymentId)
        && isSignedIn()
        && isValidPayment(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && get(/databases/$(database)/documents/students/$(incoming().studentId)).data.ownerId == request.auth.uid
        && exists(/databases/$(database)/documents/classes/$(incoming().classId))
        && get(/databases/$(database)/documents/classes/$(incoming().classId)).data.ownerId == request.auth.uid;
      allow update: if isValidId(paymentId)
        && isOwner(existing().ownerId)
        && isValidPayment(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().receiptNo == existing().receiptNo
        && incoming().studentId == existing().studentId
        && incoming().classId == existing().classId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().paymentStatus == 'partial'
            && incoming().diff(existing()).affectedKeys().hasOnly(['amountPaid', 'paymentStatus', 'method', 'paidDate', 'note', 'updatedAt']))
          || incoming().diff(existing()).affectedKeys().hasOnly(['note', 'method', 'paidDate', 'updatedAt'])
        );
      allow delete: if isValidId(paymentId) && isOwner(existing().ownerId);
    }
  }
}
